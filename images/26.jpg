<script nonce="Switac+8L9L+ALbzUuZFgw==">
(function () {
    var l = (document.documentElement.lang || '').toLowerCase().slice(0, 2);
    if (l !== 'ar' && l !== 'en') return;
    var frames = document.querySelectorAll('iframe[src*="/widget/"]');
    for (var i = 0; i < frames.length; i++) {
        var f = frames[i];
        var src = f.getAttribute('src') || '';
        if (!/[?&]lang=(ar|en)/i.test(src)) continue;
        var next = src.replace(/([?&])lang=(ar|en)/i, '$1lang=' + l);
        if (next !== src) f.src = next;
    }
})();
</script>

