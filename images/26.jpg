    <script nonce="Switac+8L9L+ALbzUuZFgw==">
    (function(){
        var menu = document.querySelector('.menu');
        if (!menu) return;
        function onScroll() {
            if (window.scrollY > 60) {
                menu.classList.add('floating');
            } else {
                menu.classList.remove('floating');
            }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
    })();


    
    
    
    
    window.SHIREEN_ENABLED_LOCALES = ["ar","en"];
    window.updateLangSwitcher = function () {
        var enabled = window.SHIREEN_ENABLED_LOCALES || ['ar'];
        var def     = enabled[0]; 
        var rest    = enabled.slice(1);
        var prefixRe = rest.length ? new RegExp('^/(' + rest.join('|') + ')(/|$)') : null;
        var path = location.pathname || '/';
        
        var stripped = prefixRe ? path.replace(prefixRe, '/') : path;
        var search = location.search || '';
        var hash   = location.hash   || '';
        document.querySelectorAll('.lang-switcher a').forEach(function (a) {
            var to = a.getAttribute('hreflang');
            if (!to) return;
            var href = (to === def)
                ? stripped
                : ('/' + to + (stripped === '/' ? '' : stripped));
            a.setAttribute('href', href + search + hash);
        });
    };
    </script>
    
